<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral rounded-pill shape; actual status color is applied at runtime via
     setBackgroundTintList (see Utils.kt themeColor()), so it works reliably across
     API levels without relying on "?attr" resolution inside <solid>. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="#FFFFFFFF" />
    <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
</shape>

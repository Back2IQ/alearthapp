<?xml version="1.0" encoding="utf-8"?>
<!-- First-run onboarding (6 steps). One Activity, one screen; steps are plain
     LinearLayout blocks toggled via visibility (mirrors the web app's #onboarding
     overlay, which does the same with the "hidden" attribute on .ob-card). No
     ViewPager2 (not a declared Gradle dependency; avoided per task boundary). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Progress dots, populated programmatically in OnboardingActivity -->
    <LinearLayout
        android:id="@+id/onboardingDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Step 1: Welcome -->
            <LinearLayout
                android:id="@+id/onboardingStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="40sp"
                    android:layout_marginBottom="12dp"
                    android:text="◎"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:text="@string/ob_title_1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:text="@string/ob_body_1" />
            </LinearLayout>

            <!-- Step 2: Location -->
            <LinearLayout
                android:id="@+id/onboardingStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:text="@string/ob_title_2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/ob_body_2" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/onboardingCityChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true" />
            </LinearLayout>

            <!-- Step 3: Protection level -->
            <LinearLayout
                android:id="@+id/onboardingStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:text="@string/ob_title_3" />

                <RadioGroup
                    android:id="@+id/onboardingProfiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/profileCautious"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/profileBalanced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/profileStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/ob_note_3" />
            </LinearLayout>

            <!-- Step 4: Alerts / notifications -->
            <LinearLayout
                android:id="@+id/onboardingStep4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:text="@string/ob_title_4" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/ob_body_4" />

                <Button
                    android:id="@+id/onboardingBtnNotify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ob_btn_notify" />
            </LinearLayout>

            <!-- Step 5: Offline rescue (info only) -->
            <LinearLayout
                android:id="@+id/onboardingStep5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:text="@string/ob_title_5" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:text="@string/ob_body_5" />
            </LinearLayout>

            <!-- Step 6: Practice alert -->
            <LinearLayout
                android:id="@+id/onboardingStep6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:text="@string/ob_title_6" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/ob_body_6" />

                <Button
                    android:id="@+id/onboardingBtnDrill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ob_btn_drill" />
            </LinearLayout>

        </FrameLayout>
    </ScrollView>

    <!-- Nav row: Back / Skip / Next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/onboardingBtnBack"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ob_back" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/onboardingBtnSkip"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/ob_skip" />

        <Button
            android:id="@+id/onboardingBtnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ob_next" />
    </LinearLayout>

</LinearLayout>

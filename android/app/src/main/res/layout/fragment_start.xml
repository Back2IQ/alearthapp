<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <!-- Status-Hero -->
        <LinearLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="24dp"
            android:background="@drawable/bg_chip" android:layout_marginBottom="16dp">
            <ImageView android:id="@+id/heroIcon" android:layout_width="56dp" android:layout_height="56dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_status_ready" />
            <TextView android:id="@+id/heroTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textSize="22sp" android:textStyle="bold"
                android:text="@string/status_ready" />
            <TextView android:id="@+id/heroSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center" android:textSize="14sp"
                android:text="@string/start_subtitle" />
        </LinearLayout>

        <!-- Standort -->
        <TextView android:id="@+id/locationBadge" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" android:textSize="15sp" android:drawablePadding="6dp"
            android:text="@string/start_location_format" />

        <!-- Alarm zurücksetzen (nur wenn Status != READY) -->
        <Button android:id="@+id/btnClearStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/home_clear" android:visibility="gone" android:layout_marginBottom="16dp" />

        <!-- Nächstes Beben in der Nähe -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textStyle="bold" android:text="@string/start_nearest_title" />
        <TextView android:id="@+id/nearestPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textSize="13sp" android:text="@string/start_nearest_placeholder" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- English (default) strings for the first-run onboarding flow (OnboardingActivity).
     Content mirrors the web app's onboarding overlay (webapp/index.html #onboarding),
     trimmed to the 6 native steps (no GPS/location-permission step, no sound toggle,
     no "would have warned you" retro preview; see OnboardingActivity task spec). -->
<resources>
    <string name="ob_back">Back</string>
    <string name="ob_skip">Skip</string>
    <string name="ob_next">Next</string>
    <string name="ob_finish">Done</string>
    <string name="ob_step_cd">Step %1$d of %2$d</string>

    <!-- Step 1: welcome -->
    <string name="ob_title_1">Welcome to TDA</string>
    <string name="ob_body_1">TDA warns you seconds before the shaking arrives and shows every natural hazard near you.</string>

    <!-- Step 2: location -->
    <string name="ob_title_2">Where should we watch?</string>
    <string name="ob_body_2">Pick a city. You can change this any time in Settings.</string>

    <!-- Step 3: protection level -->
    <string name="ob_title_3">Choose a protection level</string>
    <string name="ob_profile_cautious">Cautious</string>
    <string name="ob_profile_cautious_desc">radius 500 km · from M 2.5</string>
    <string name="ob_profile_balanced">Balanced</string>
    <string name="ob_profile_balanced_desc">radius 300 km · from M 3.5</string>
    <string name="ob_profile_strong">Strong only</string>
    <string name="ob_profile_strong_desc">radius 150 km · from M 5.0</string>
    <string name="ob_profile_row_format">%1$s — %2$s</string>
    <string name="ob_note_3">Magnitude = strength; radius = how far away a quake still concerns you. Fine sliders stay in Settings.</string>

    <!-- Step 4: alerts / notifications -->
    <string name="ob_title_4">Alerts</string>
    <string name="ob_body_4">Allow notifications so TDA can reach you even when the app is in the background.</string>
    <string name="ob_btn_notify">Enable notifications</string>

    <!-- Step 5: offline rescue -->
    <string name="ob_title_5">Offline rescue</string>
    <string name="ob_body_5">If the mobile network goes down, this app can carry warnings and an SOS phone-to-phone over Bluetooth. This only works natively here -- some of it is already active, the rest is coming soon.</string>

    <!-- Step 6: practice alert -->
    <string name="ob_title_6">This is what an alert looks like</string>
    <string name="ob_body_6">Try a practice alert so you recognise the sound and screen in a real event.</string>
    <string name="ob_btn_drill">Show a practice alert</string>
</resources>
